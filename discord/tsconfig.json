{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "rootDir": "src", "outDir": "dist",
    "types": ["node"], "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
