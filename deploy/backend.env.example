# Managed by Chat On Steroids headless deployment; mode 0600, never commit real secrets.
COS_RUNTIME_MODE=headless
COS_DATA_DIR=/var/lib/cos-backend/app
COS_BROWSER_PROFILE=/var/lib/cos-backend/brave
COS_BROWSER_EXECUTABLE=/usr/bin/brave-browser
COS_CONTROL_DIRECTORY=/run/cos-control
# Replace with: getent group cos-control | cut -d: -f3
COS_CONTROL_GID=REPLACE_LOCALLY
# Explicit local bootstrap grants; empty disables every new remote mutation.
COS_REMOTE_PERMISSIONS=
COS_INSTALL_DIR=/opt/chat-on-steroids/current
