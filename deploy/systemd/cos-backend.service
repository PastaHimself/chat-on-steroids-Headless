# Managed by Chat On Steroids headless deployment
[Unit]
Description=Chat On Steroids headless backend
PartOf=cos-headless.target
Requires=cos-display.service cos-session.service
Wants=network-online.target cos-browser.service
After=network-online.target cos-display.service cos-session.service cos-browser.service

[Service]
Type=simple
User=cos-backend
Group=cos-backend
SupplementaryGroups=cos-control
RuntimeDirectory=cos-control
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/chat-on-steroids/backend.env
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/cos-display/Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/cos-session/bus
WorkingDirectory=/opt/chat-on-steroids/current
ExecStartPre=/opt/chat-on-steroids/current/deploy/check-display.sh
ExecStart=/opt/chat-on-steroids/current/deploy/start-backend.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=95
KillMode=control-group
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=false
ReadWritePaths=/var/lib/cos-backend /srv/cos-projects /run/cos-control /tmp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=cos-headless.target
