# Managed by Chat On Steroids headless deployment; root-owned mode 0600.
DISCORD_BOT_TOKEN=REPLACE_LOCALLY
DISCORD_APPLICATION_ID=REPLACE_LOCALLY
DISCORD_ADMIN_IDS=REPLACE_LOCALLY
DISCORD_GUILD_IDS=REPLACE_LOCALLY
# Optional additional local channel restriction. Setup cannot widen it.
DISCORD_CHANNEL_IDS=
COS_CONTROL_DIRECTORY=/run/cos-control
DISCORD_DATA_DIR=/var/lib/cos-discord
